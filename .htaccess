RewriteEngine On
RewriteBase /

# Treat /index and /index/ as the homepage, not an activity slug.
RewriteRule ^index/?$ index.html [L,QSA]

# Class leader dashboard
RewriteRule ^leader/?$ leader.html [L,QSA]

# Clean section URLs
RewriteRule ^planner/?$ planner.html [L,QSA]
RewriteRule ^directory/?$ directory.html [L,QSA]
RewriteRule ^events/?$ events.html [L,QSA]
RewriteRule ^venues/?$ venues.html [L,QSA]
RewriteRule ^schools/?$ schools.html [L,QSA]

# Clean personalised finder URL: /choose
RewriteRule ^choose/?$ choose.html [L,QSA]

# Keep the old personalised URL working and move it to /choose
RewriteRule ^personalise(?:\.html)?/?$ /choose [R=301,L]

# Clean account sub-pages: /account/profile, /account/preferences, etc.
# Keep the physical account/*.html files as the source of truth.
RewriteCond %{DOCUMENT_ROOT}/account/$1.html -f
RewriteRule ^account/([a-z0-9-]+)/?$ account/$1.html [L,QSA]

# Organiser custom Terms URLs: /{organiser-slug}terms.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)terms\.html$ organiser-terms.html?slug=$1 [B,L,QSA]

RewriteRule ^organiser/([^/]+)/terms\.html$ organiser-terms.html?slug=$1 [B,L,QSA]

# Organiser storefront URLs: /organiser/{company-name}/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^organiser/([^/]+)/?$ organiser.html?slug=$1 [B,L,QSA]

# Clean activity URLs: /{activity-slug}/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/?$ activity.html?slug=$1 [L,QSA]
