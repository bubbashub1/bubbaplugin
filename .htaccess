RewriteEngine On
RewriteBase /beta/

# Clean section URLs
RewriteRule ^events/?$ events.html [L,QSA]
RewriteRule ^venues/?$ venues.html [L,QSA]
RewriteRule ^schools/?$ schools.html [L,QSA]

# Clean personalised finder URL: /beta/choose
RewriteRule ^choose/?$ choose.html [L,QSA]

# Keep the old personalised URL working and move it to /choose
RewriteRule ^personalise(?:\.html)?/?$ /beta/choose [R=301,L]

# Organiser storefront URLs: /beta/leader/{company-name}/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^organiser/([^/]+)/?$ organiser.html?slug=$1 [L,QSA]

# Clean activity URLs: /beta/{activity-slug}/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/?$ activity.html?slug=$1 [L,QSA]
