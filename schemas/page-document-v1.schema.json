{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bubbahub.co.uk/schemas/page-document-v1.schema.json",
  "title": "Bubba Hub visual page document",
  "description": "Strict data-only contract for the Visual Builder v1 test build. The PHP validator additionally checks that each block's column index fits its parent section's column count.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "page",
    "settings",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "slug"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 190
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 190
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_width": {
          "enum": [
            "960px",
            "1100px",
            "1200px"
          ]
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "sections": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "section"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "padding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 96
            },
            "gap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "width": {
              "type": "integer",
              "minimum": 25,
              "maximum": 100
            },
            "min_height": {
              "type": "integer",
              "minimum": 0,
              "maximum": 800
            },
            "radius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            },
            "border_width": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "border_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "margin_bottom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 96
            },
            "mobile": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 25,
                  "maximum": 100
                },
                "padding": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 96
                },
                "gap": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 64
                },
                "min_height": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 800
                },
                "radius": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 48
                },
                "border_width": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                },
                "margin_bottom": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 96
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                }
              }
            },
            "background_image": {
              "type": "string",
              "maxLength": 2048
            },
            "overlay_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "overlay_opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "background_position": {
              "enum": [
                "center center",
                "center top",
                "center bottom",
                "left center",
                "right center"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "palette": {
              "enum": [
                "custom",
                "meadow",
                "coastal",
                "sunshine",
                "blush",
                "neutral"
              ]
            },
            "gradient": {
              "enum": [
                "",
                "meadow",
                "coastal",
                "sunset",
                "berry",
                "sand"
              ]
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "column_widths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 10,
                "maximum": 100
              }
            }
          }
        },
        "children": {
          "type": "array",
          "maxItems": 80,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/heading"
              },
              {
                "$ref": "#/$defs/paragraph"
              },
              {
                "$ref": "#/$defs/button"
              },
              {
                "$ref": "#/$defs/image"
              },
              {
                "$ref": "#/$defs/directory_search"
              },
              {
                "$ref": "#/$defs/library_widget"
              }
            ]
          }
        }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "props"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "heading"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "level"
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 500
            },
            "level": {
              "enum": [
                1,
                2,
                3,
                4
              ]
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "font_size": {
              "type": "integer",
              "minimum": 10,
              "maximum": 72
            },
            "width": {
              "type": "integer",
              "minimum": 10,
              "maximum": 100
            },
            "margin_bottom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "radius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            },
            "padding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            }
          }
        }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "props"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "paragraph"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 10000
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "font_size": {
              "type": "integer",
              "minimum": 10,
              "maximum": 72
            },
            "width": {
              "type": "integer",
              "minimum": 10,
              "maximum": 100
            },
            "margin_bottom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "radius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            },
            "padding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            }
          }
        }
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "props"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "button"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "href"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "href": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^(https?://|mailto:|tel:|/(?!/)|#|\\\\?).+"
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "font_size": {
              "type": "integer",
              "minimum": 10,
              "maximum": 72
            },
            "width": {
              "type": "integer",
              "minimum": 10,
              "maximum": 100
            },
            "margin_bottom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "radius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            },
            "padding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "props"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "image"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "src",
            "alt"
          ],
          "properties": {
            "src": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^(https://|/(?!/)).+"
            },
            "alt": {
              "type": "string",
              "maxLength": 300
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "font_size": {
              "type": "integer",
              "minimum": 10,
              "maximum": 72
            },
            "width": {
              "type": "integer",
              "minimum": 10,
              "maximum": 100
            },
            "margin_bottom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "radius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            },
            "padding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            },
            "fit": {
              "enum": [
                "cover",
                "contain"
              ]
            }
          }
        }
      }
    },
    "directory_search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "props"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "directory_search"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "placeholder"
          ],
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 100
            },
            "placeholder": {
              "type": "string",
              "maxLength": 150
            },
            "search_scope": {
              "enum": [
                "all",
                "activities",
                "businesses",
                "childcare",
                "events",
                "places",
                "school_clubs"
              ]
            },
            "show_filters": {
              "type": "boolean"
            },
            "search_fields": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "maxItems": 80,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              }
            },
            "filter_fields": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "maxItems": 80,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              }
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "font_size": {
              "type": "integer",
              "minimum": 10,
              "maximum": 72
            },
            "width": {
              "type": "integer",
              "minimum": 10,
              "maximum": 100
            },
            "margin_bottom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "radius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            },
            "padding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            }
          }
        }
      }
    },
    "library_widget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "props"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "library_widget"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "widget_key",
            "widget_type",
            "name",
            "settings"
          ],
          "properties": {
            "widget_key": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
            },
            "widget_type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,59}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "settings": {
              "type": "object"
            },
            "text": {
              "type": "string",
              "maxLength": 500
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "font_size": {
              "type": "integer",
              "minimum": 10,
              "maximum": 72
            },
            "width": {
              "type": "integer",
              "minimum": 10,
              "maximum": 100
            },
            "margin_bottom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "radius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            },
            "padding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            }
          }
        }
      }
    }
  }
}
